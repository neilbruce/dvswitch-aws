[Unit]
Description=Gunicorn instance to serve DMR NCS Platform admin console
After=network-online.target apache2.service
Wants=network-online.target

[Service]
User=dmrncs
Group=www-data
WorkingDirectory=/opt/dmr_ncs_system
Environment="PATH=/opt/dmr_ncs_system/venv/bin"
EnvironmentFile=/etc/dmr-ncs.env
ExecStartPre=/opt/dmr_ncs_system/venv/bin/alembic -c /opt/dmr_ncs_system/alembic.ini upgrade head
ExecStart=/opt/dmr_ncs_system/venv/bin/gunicorn --workers ${GUNICORN_WORKERS} --bind 127.0.0.1:${PORT} --access-logfile /var/log/gunicorn/access.log --error-logfile /var/log/gunicorn/error.log --timeout 120 app:app
Restart=always
RestartSec=5
StartLimitIntervalSec=300
StartLimitBurst=5
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/dmr_ncs_system /var/log/gunicorn /var/log/mmdvm /tmp
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
