# Required security
SECRET_KEY=replace-with-openssl-rand-hex-32
JWT_SECRET=replace-with-openssl-rand-hex-32
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=replace-with-a-long-random-password
SESSION_COOKIE_SECURE=true
SESSION_LIFETIME_SECONDS=21600

# Station identity
STATION_CALLSIGN=YOURCALL
STATION_DMR_ID=1234567
REPEATER_ID=
DEFAULT_TALKGROUP=91
SERVER_PUBLIC_IP=

# Flask / database
PORT=5000
DATABASE_URL=sqlite:////opt/dmr_ncs_system/dmr_control_station.db
BACKUP_RETENTION_DAYS=30

# DVSwitch / logs
AB_INFO_FILE=/tmp/ABInfo_31001.json
DVSWITCH_SCRIPT=/opt/MMDVM_Bridge/dvswitch.sh
MMDVM_LOG_DIR=/var/log/mmdvm
MMDVM_LOG_PATH=
DVSWITCH_LOG_PATH=/var/log/dvswitch/dvswitch.log
ANALOG_BRIDGE_LOG_PATH=/var/log/dvswitch/Analog_Bridge.log

# systemd units
APACHE_SERVICE=apache2
GUNICORN_SERVICE=dmr-ncs
ANALOG_BRIDGE_SERVICE=Analog_Bridge
MMDVM_BRIDGE_SERVICE=MMDVM_Bridge
DVSWITCH_SERVICE=md380-emu
ENABLE_HOST_REBOOT=false

# Radio integrations
RADIOID_URL=https://radioid.net/api/dmr/user/
RADIOID_CACHE_HOURS=168
RADIOID_MIN_INTERVAL_SECONDS=1.2
BRANDMEISTER_TALKGROUP_URL=https://api.brandmeister.network/v2/talkgroup/
BRANDMEISTER_LASTHEARD_URL=https://api.brandmeister.network/v2/lastheard/
BRANDMEISTER_MASTERS_URL=https://api.brandmeister.network/v2/master/

# APRS-IS
APRS_ENABLED=true
APRS_IS_HOST=rotate.aprs2.net
APRS_IS_PORT=14580
APRS_IS_CALLSIGN=YOURCALL
APRS_IS_PASSCODE=-1
APRS_IS_FILTER=t/poimqstunw
APRS_RETENTION_DAYS=30
APRS_MAX_ROWS=5000

# Net automation
NCS_TIMEZONE=Asia/Kolkata
NET_AUTOMATIC_TG=91
NET_START_HOUR=21
NET_START_MINUTE=30
NET_CLOSE_HOUR=3
NET_CLOSE_MINUTE=0
